# copy to .env (gitignored) and fill in; any OpenAI-compatible endpoint works
# NVIDIA API catalog (free prototyping tier, used for the reported run):
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
JUDGE_NO_THINK=1        # reasoning model: switch thinking off for a short rubric judgement (~1-2 s/call)
JUDGE_JSON_MODE=0
JUDGE_ATTEMPTS=4
# OpenRouter free tier (50 requests/day) instead:
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_MODEL=nvidia/nemotron-3.5-super-vl:free
